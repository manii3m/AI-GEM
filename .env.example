# Supabase Cloud Database Configuration
# Create a project at https://supabase.com/
# Copy your Project URL and anon public API key from Project Settings -> API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Gemini API Key for Document OCR and Information Extraction
# Get your API key from Google AI Studio: https://aistudio.google.com/
# If not provided, the platform automatically utilizes a realistic high-fidelity OCR simulation engine.
VITE_GEMINI_API_KEY=
